<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Managed bindings for the x64dbg plugin SDK. Pure P/Invoke against the
    debugger's own bridge DLL, so it takes no package dependencies. The DLL it
    binds to differs per architecture and is selected by the X64 constant that
    Directory.Build.props derives from the platform.

    The reference to ERC.Net that used to live here was unused - nothing in this
    project touches the ERC namespace.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Managed.x64dbg</AssemblyName>
    <RootNamespace>Managed.x64dbg</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
