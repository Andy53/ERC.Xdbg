<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Supplies the DllExport marker attribute that the DllExport build step looks
    for. The step requires this as a real assembly on disk ("MetaLib"), which the
    upstream wizard would generate into a machine-local cache outside the repo.
    Building it from source here keeps the whole toolchain in version control.

    The output path is deliberately fixed - no platform or framework subfolders -
    so the plugin project can point at it with a single stable path.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>

    <!--
      The file has to be called DllExport.dll, because that is the name the IL
      rewriter's MetaLib setting points at.

      PackageId has to be something else. A project's NuGet identity defaults to
      its assembly name, so with both called "DllExport" this project collided with
      the DllExport PackageReference in the plugin - and a project reference wins.
      NuGet therefore considered the dependency already satisfied and never
      downloaded the real package, so its targets were absent and the plugin was
      built with no native exports.

      That is invisible on a machine whose package cache already holds DllExport
      from an earlier restore, which is why this only ever failed on a clean
      checkout. IsPackable does not help: identity is used during restore whether
      or not the project is packable.
    -->
    <AssemblyName>DllExport</AssemblyName>
    <PackageId>ErcXdbg.DllExportMeta</PackageId>
    <RootNamespace>ErcXdbg</RootNamespace>

    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Never shipped: it exists only to satisfy the compiler and the IL rewriter. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

</Project>
