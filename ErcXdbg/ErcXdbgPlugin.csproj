<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The x64dbg plugin itself.

    x64dbg loads plugins as native DLLs and looks for the entry points by their
    exported names, so after the C# compiler runs, the DllExport build step
    rewrites the IL to add a real native export table. That step needs full
    MSBuild (from Visual Studio or the Build Tools) - "dotnet build" alone cannot
    produce a loadable plugin. Use build.ps1, which finds MSBuild for you.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Erc.Xdbg</AssemblyName>
    <RootNamespace>ErcXdbg</RootNamespace>
    <!--
      Assembly metadata is generated from MSBuild properties, so the version comes
      from Directory.Build.props like everything else. It used to be turned off in
      favour of a hand-written AssemblyInfo.cs, which hard-coded 1.0.0.0 and had
      never been touched: every release since the first reported version 1.0.0.0 in
      its file properties regardless of what was being released.
    -->
    <AssemblyTitle>ErcXdbgPlugin</AssemblyTitle>
    <Description>ERC plugin for X64dbg</Description>
    <Trademark>by Andy Bowden</Trademark>
    <ComVisible>false</ComVisible>

    <!-- Unify the versions Reloaded and Costura disagree on, to keep the merged plugin loadable. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      DllExport configuration. DllExportNamespace tells the rewriter which
      attribute marks an export; it resolves to ErcXdbg.DllExportAttribute, which
      is built from source by build/DllExportMeta rather than generated into a
      machine-local cache by the upstream wizard.
    -->
    <DllExportNamespace>ErcXdbg</DllExportNamespace>
    <DllExportOrdinalsBase>1</DllExportOrdinalsBase>
    <DllExportGenExpLib>false</DllExportGenExpLib>
    <DllExportOurILAsm>true</DllExportOurILAsm>
    <DllExportMetaLibFullPath>$(MSBuildThisFileDirectory)..\build\DllExportMeta\bin\DllExport.dll</DllExportMetaLibFullPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERC\ERC\ERC.Net.csproj" />
    <ProjectReference Include="..\Managed.x64dbg\Managed.x64dbg.csproj" />
    <!-- Compile-time marker only; stripped from the IL by the DllExport step. -->
    <ProjectReference Include="..\build\DllExportMeta\DllExportMeta.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Merges every managed dependency into the single plugin file x64dbg loads. -->
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.5.5" PrivateAssets="all" />
    <!--
      GeneratePathProperty asks NuGet to define $(PkgDllExport) pointing at wherever
      this package actually landed. The import below used to build that path itself
      from $(NuGetPackageRoot), which assumes the package resolved out of the global
      packages folder - true on a developer machine, not necessarily true elsewhere.
      When the assumption failed the import was silently skipped and the plugin was
      produced without its native exports.
    -->
    <PackageReference Include="DllExport" Version="1.7.4" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FodyWeavers.xml" />
  </ItemGroup>

  <!--
    The DllExport package ships no build/ folder, so NuGet does not auto-import its
    targets; the import is explicit. Both properties are only set once restore has
    written obj/*.nuget.g.props, hence the Exists guards.

    $(PkgDllExport) is NuGet's own answer to "where did this package go" and is
    tried first. The hand-built path is kept as a fallback for the case where the
    package was restored by something that does not emit the path property.
  -->
  <PropertyGroup>
    <!--
      Path.Combine, not string concatenation.

      NuGetPackageRoot is not guaranteed to end in a separator: it is
      "...\.nuget\packages\" when NuGet defaults it, and "...\erc-clean-nuget"
      with no trailing slash when NUGET_PACKAGES names the folder. The import here
      used to append "dllexport\..." directly, which produced
      "...\erc-clean-nugetdllexport\..." in the second case - a path that never
      exists, so the Exists condition silently skipped the import and the plugin
      was built with no native exports.

      NuGet's own generated import in obj\*.nuget.g.props writes
      "$(NuGetPackageRoot)\costura.fody\..." with an explicit separator, which is
      the same problem seen from the other side: it cannot rely on one either.
    -->
    <ErcDllExportTargets Condition="'$(PkgDllExport)' != ''">$([System.IO.Path]::Combine('$(PkgDllExport)', 'tools', 'net.r_eg.DllExport.targets'))</ErcDllExportTargets>
    <ErcDllExportTargets Condition="!Exists('$(ErcDllExportTargets)') And '$(NuGetPackageRoot)' != ''">$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'dllexport', '1.7.4', 'tools', 'net.r_eg.DllExport.targets'))</ErcDllExportTargets>
  </PropertyGroup>

  <Import Project="$(ErcDllExportTargets)" Condition="Exists('$(ErcDllExportTargets)')" />

  <Target Name="ErcVerifyDllExportRan" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!--
      Without the native export table x64dbg silently refuses to load the plugin,
      which is a slow and confusing failure. Fail the build here instead.

      The message reports what was looked for. This failed on CI for months while
      building perfectly on a developer machine, and "targets were not imported"
      alone gave nothing to act on.
    -->
    <PropertyGroup>
      <ErcDllExportTargetsFound>no</ErcDllExportTargetsFound>
      <ErcDllExportTargetsFound Condition="Exists('$(ErcDllExportTargets)')">yes</ErcDllExportTargetsFound>
    </PropertyGroup>

    <Error Condition="'$(DllExportModImported)' != 'true'"
           Text="DllExport targets were not imported, so the plugin has no native exports and x64dbg would not load it.%0A  PkgDllExport       = '$(PkgDllExport)'%0A  NuGetPackageRoot   = '$(NuGetPackageRoot)'%0A  NuGetPackageFolders= '$(NuGetPackageFolders)'%0A  targets looked for = '$(ErcDllExportTargets)'%0A  targets found      = $(ErcDllExportTargetsFound)%0A  MSBuild            = $(MSBuildBinPath)%0ARestore first, then build with full MSBuild (see build.ps1)." />
  </Target>

  <Target Name="ErcRenameToPluginExtension" AfterTargets="Build" DependsOnTargets="ErcVerifyDllExportRan"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(TargetPath)" Outputs="$(TargetDir)$(TargetName).dp$(ErcArchSuffix)">
    <!--
      x64dbg discovers plugins by extension: .dp32 for 32-bit, .dp64 for 64-bit.

      This is done as a post-build copy rather than by setting TargetExt, because
      the DllExport step shells out to ILAsm, which parses a ".dp32" output path
      as the command-line option "/DP32" and fails. Building as .dll and copying
      afterwards keeps that tool happy.
    -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).dp$(ErcArchSuffix)" />
  </Target>

</Project>
